APP_DEBUG = false

DEFAULT_LANG = zh-cn
DEFAULT_TIMEZONE = Asia/Shanghai

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = pack_submit
DB_USER = root
DB_PASS =
DB_PORT = 3306
DB_CHARSET = utf8mb4
DB_PREFIX = pf_

# 请执行 php -r "echo bin2hex(random_bytes(32));" 生成后替换
JWT_SECRET =
# token 有效期(秒)
JWT_TTL = 7200
# 刷新有效期(分钟)：过期 token 在该时间窗内仍可换取新 token
JWT_REFRESH_TTL = 20160

## 安全相关
# 允许跨域的来源，多个用英文逗号分隔；为空表示不开放跨域（前端与接口同域部署时无需配置）
CORS_ALLOW_ORIGIN =

# 登录失败锁定：同一账号+IP 允许的失败次数 / 同一 IP 允许的失败次数 / 锁定时长(秒)
LOGIN_MAX_ATTEMPTS = 5
LOGIN_MAX_IP_ATTEMPTS = 20
LOGIN_LOCK_SECONDS = 900
