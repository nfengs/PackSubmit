# 环境变量覆盖 configs/config.yaml 中的同名配置（PS_ 前缀）
# 生产环境务必设置 JWT secret 与数据库密码

PS_SERVER_ADDR=:8080
PS_SERVER_MODE=release
PS_SERVER_STATIC_DIR=../frontend/dist

PS_DB_HOST=127.0.0.1
PS_DB_PORT=3306
PS_DB_USER=root
PS_DB_PASSWORD=
PS_DB_NAME=pack_submit

PS_JWT_SECRET=
PS_JWT_TTL_MINUTES=120
PS_JWT_REFRESH_MINUTES=20160

PS_STORAGE_ATTACHMENTS=storage/attachments
PS_TEMPLATE_PACK=templates/包装确认单-模板 20260730.xlsx

# 跨域白名单，逗号分隔；为空表示不开放跨域
PS_CORS_ALLOW_ORIGINS=

PS_LOGIN_MAX_ATTEMPTS=5
PS_LOGIN_MAX_IP_ATTEMPTS=20
PS_LOGIN_LOCK_SECONDS=900

PS_MIGRATIONS_DIR=migrations
